# Public client configuration only. Flutter reads --dart-define-from-file, not .env.
APP_ENV=production
API_BASE_URL=https://YOUR-API.onrender.com
APP_PUBLIC_URL=https://YOUR-APP.pages.dev
# See config/production.example.json. Never put server credentials in client builds.
# Signing secrets are read from your LOCAL environment only; do not commit values.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
